---
import { site } from '../site.config';
import { getLangFromUrl, useTranslations, localizedNav, localizePath } from '../i18n/utils';
import LangSwitch from './LangSwitch.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const nav = localizedNav(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' || path === '/en' : path === h || path.startsWith(h + '/');
};
---

<header class="site-header">
  <div class="container bar">
    <a href={localizePath('/', lang)} class="wordmark" aria-label={`${site.name} - ${t('nav.home')}`}>
      {site.name}<sup>{site.mark}</sup>
    </a>

    <nav class="nav" aria-label={t('a11y.primaryNav')}>
      <ul class="nav-list" id="nav-list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-lang"><LangSwitch /></li>
      </ul>
    </nav>

    <div class="right">
      <div class="desk-lang"><LangSwitch /></div>
      <button
        class="burger"
        id="burger"
        aria-label={t('a11y.toggleMenu')}
        aria-expanded="false"
        aria-controls="nav-list"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1.05rem;
  }
  .wordmark sup { font-size: 0.55em; margin-left: 1px; color: var(--muted); }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  .nav-lang { display: none; }
  .right { display: flex; align-items: center; gap: 1.25rem; }
  .desk-lang { display: inline-flex; }

  .nav-link {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--muted);
    padding: 0.25rem 0;
    position: relative;
    transition: color 0.3s var(--ease);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .nav-link:hover { color: var(--text); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link.active { color: var(--text); }
  .nav-link.active::after { transform: scaleX(1); }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px; height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .burger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  @media (max-width: 760px) {
    .burger { display: flex; }
    .desk-lang { display: none; }
    .nav-lang { display: block; }
    .nav-list {
      position: fixed;
      inset: 68px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 1rem var(--pad) 2rem;
      transform: translateY(-120%);
      transition: transform 0.4s var(--ease);
      pointer-events: none;
    }
    .nav-list.is-open { transform: none; pointer-events: auto; }
    .nav-list li { border-bottom: 1px solid var(--border); }
    .nav-link { display: block; padding: 1rem 0; font-size: 1rem; }
    .nav-lang { padding: 1rem 0; }

    .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const list = document.getElementById('nav-list');
  burger?.addEventListener('click', () => {
    const open = list?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(!!open));
  });
  list?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      list.classList.remove('is-open');
      burger?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
